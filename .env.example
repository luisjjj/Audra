# Audra — Every action. Accounted for.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/audra?sslmode=require"
BETTER_AUTH_SECRET="replace-with-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
# R2 / S3-compatible
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="audra-documents"
R2_PUBLIC_URL=""
R2_ENDPOINT=""
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Demo mode: when DATABASE_URL is missing, app runs on seeded in-memory data
DEMO_MODE="true"
